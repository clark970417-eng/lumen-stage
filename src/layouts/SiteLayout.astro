---
interface Props { publicPage?: boolean; title?: string }
const { publicPage = false, title = 'Lumen Stage — Virtual Photography Studio' } = Astro.props
const base = import.meta.env.BASE_URL
---
<html lang="en" class:list={{ 'public-site-root': publicPage }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#07090b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Lumen Stage" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content="Plan the light and frame the shot in one live browser studio—before the real shoot begins." />
    <meta name="author" content="YuYing" />
    <meta name="copyright" content="© 2026 YuYing. All rights reserved." />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumen Stage" />
    <meta property="og:title" content="Lumen Stage — Plan the light. Frame the shot." />
    <meta property="og:description" content="Build lighting, camera and subject decisions in one live browser studio." />
    <meta property="og:url" content="https://lumen-stage.vercel.app/" />
    <meta property="og:image" content="https://lumen-stage.vercel.app/og-image.jpg?v=20260830-2" />
    <meta property="og:image:secure_url" content="https://lumen-stage.vercel.app/og-image.jpg?v=20260830-2" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lumen Stage virtual photography studio with the message Plan the light, Frame the shot" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Lumen Stage — Plan the light. Frame the shot." />
    <meta name="twitter:description" content="Build lighting, camera and subject decisions in one live browser studio." />
    <meta name="twitter:image" content="https://lumen-stage.vercel.app/og-image.jpg?v=20260830-2" />
    <meta name="twitter:image:alt" content="Lumen Stage virtual photography studio with the message Plan the light, Frame the shot" />
    <link rel="canonical" href="https://lumen-stage.vercel.app/" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}icons/icon-180.png`} />
    <link id="app-manifest" rel="manifest" href={`${base}site.webmanifest`} />
    <script>
      (() => {
        const manifest = document.getElementById('app-manifest')
        const mode = new URLSearchParams(location.search).get('ui')
        const desktop = mode === 'full' || (mode !== 'mobile' && matchMedia('(min-width: 901px) and (pointer: fine)').matches)
        if (desktop && manifest) manifest.href = manifest.href.replace('site.webmanifest', 'desktop.webmanifest')
      })()
    </script>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Lumen Stage","applicationCategory":"MultimediaApplication","operatingSystem":"Web","url":"https://lumen-stage.vercel.app/","description":"Interactive 3D photography studio for planning lights, cameras, lenses and portrait setups.","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"author":{"@type":"Person","name":"YuYing"}}</script>
    <title>{title}</title>
  </head>
  <body class:list={{ 'public-site-body': publicPage }}><div id="root"><slot /></div></body>
</html>
